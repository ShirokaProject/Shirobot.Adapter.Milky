<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ShiroBotSourceRoot Condition="'$(ShiroBotSourceRoot)' == ''">$(MSBuildProjectDirectory)/../../ShiroBot</ShiroBotSourceRoot>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AssemblyName>ShiroBot.Adapter.Milky</AssemblyName>
        <RootNamespace>ShiroBot.Adapter.Milky</RootNamespace>
        <HostAdapterDir>..\..\ShiroBot\Core\bin\Debug\$(TargetFramework)\adapters\ShiroBot.Adapter.Milky\</HostAdapterDir>
        <Configurations>Debug;Release</Configurations>
        <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
        <ShiroBotPluginPackagingEnabled>true</ShiroBotPluginPackagingEnabled>
    </PropertyGroup>

    <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.props" />

    <ItemGroup>
        <!-- 子项目目录不参与适配器本体编译 -->
        <Compile Remove="ShiroBot.Model/**/*.cs" />
        <Compile Remove="MilkyModelGenerator.Net/**/*.cs" />
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="shirobot-host/**/*.cs" />
        <EmbeddedResource Remove="shirobot-host/**/*" />
        <None Remove="shirobot-host/**/*" />
        <EmbeddedResource Remove="tests/**/*" />
        <None Remove="tests/**/*" />
    </ItemGroup>

    <ItemGroup>
        <!-- Milky 协议 DTO(本仓私有模型,由 MilkyModelGenerator.Net 生成),随适配器一起打包 -->
        <ProjectReference Include="ShiroBot.Model\ShiroBot.Model.csproj" />
        <ProjectReference Include="$(ShiroBotSourceRoot)/SDK/ShiroBot.SDK.csproj" Private="false" />
        <ProjectReference Include="$(ShiroBotSourceRoot)/Models/QQ/ShiroBot.Model.QQ.csproj" Private="false" />
    </ItemGroup>

    <Target Name="CopyAdapterToHost"
            AfterTargets="Build"
            Condition="'$(Configuration)'=='Debug' and '$(CopyAdapterToHost)'!='false'">
        <RemoveDir Directories="$(MSBuildProjectDirectory)\..\..\ShiroBot\Core\bin\Debug\$(TargetFramework)\adapters\ShiroBot.MilkyAdapter" />
        <MakeDir Directories="$(HostAdapterDir)" />

        <ItemGroup>
            <AdapterDebugOutput Include="$(TargetDir)**\*"
                                 Exclude="$(TargetDir)ShiroBot.SDK.dll;$(TargetDir)ShiroBot.SDK.pdb;$(TargetDir)ShiroBot.Model.QQ.dll;$(TargetDir)ShiroBot.Model.QQ.pdb;$(TargetDir)ShiroBot.MilkyAdapter.dll;$(TargetDir)ShiroBot.MilkyAdapter.pdb;$(TargetDir)ShiroBot.MilkyAdapter.deps.json;$(TargetDir)ShiroBot.Model.dll;$(TargetDir)ShiroBot.Model.pdb" />
        </ItemGroup>

        <Copy SourceFiles="@(AdapterDebugOutput)"
              DestinationFiles="@(AdapterDebugOutput->'$(HostAdapterDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.targets" />
</Project>
