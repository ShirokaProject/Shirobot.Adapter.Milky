<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>2.2.5</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AssemblyName>ShiroBot.Adapter.Milky</AssemblyName>
        <RootNamespace>ShiroBot.Adapter.Milky</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Debug'">false</ShiroBotPluginPackagingEnabled>
        <ShiroBotAvaloniaPreviewerSupport Condition="'$(Configuration)' == 'Debug'">true</ShiroBotAvaloniaPreviewerSupport>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <!-- 子项目目录不参与适配器本体编译 -->
        <Compile Remove="ShiroBot.Model/**/*.cs" />
        <Compile Remove="MilkyModelGenerator.Net/**/*.cs" />
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="TestPlugin/**/*.cs" />
        <Compile Remove="scripts/**/*.cs" />
        <Compile Remove=".shirobot-dev/**/*.cs" />
        <Compile Remove="shirobot-host/**/*.cs" />
        <EmbeddedResource Remove="shirobot-host/**/*" />
        <None Remove="shirobot-host/**/*" />
        <EmbeddedResource Remove="tests/**/*" />
        <None Remove="tests/**/*" />
    </ItemGroup>

    <ItemGroup>
        <!-- Milky 协议 DTO(本仓私有模型,由 MilkyModelGenerator.Net 生成),发布时由 SDK ILRepack 合并到适配器 DLL -->
        <ProjectReference Include="ShiroBot.Model\ShiroBot.Model.csproj" />
        <PackageReference Include="ShiroBot.SDK" Version="$(ShiroBotSdkVersion)" />
        <ProjectReference Include="TestPlugin/ShiroBot.Adapter.Milky.TestPlugin.csproj"
                          Condition="'$(Configuration)' == 'Debug'"
                          ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>

</Project>
