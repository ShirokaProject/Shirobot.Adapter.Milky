<Project>
  <Target Name="PrepareShiroBotLaunchSettings" BeforeTargets="Restore;Build"
          Condition="'$(MSBuildProjectName)' == 'ShiroBot.Adapter.Milky'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Properties/launchSettings.Unix.json"
          DestinationFiles="$(MSBuildProjectDirectory)/Properties/launchSettings.json"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT'" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Properties/launchSettings.Windows.json"
          DestinationFiles="$(MSBuildProjectDirectory)/Properties/launchSettings.json"
          SkipUnchangedFiles="true" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>
  <!-- Run and Debug use the same direct host launch profile; prepare its files during Debug builds. -->
  <Target Name="PrepareShiroBotDevelopmentHost" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'ShiroBot.Adapter.Milky' and '$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(OS)' != 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="/bin/sh &quot;$(MSBuildProjectDirectory)/scripts/dev.sh&quot; --prepare --no-build" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/scripts/dev.ps1&quot; --prepare --no-build" />
  </Target>
</Project>
