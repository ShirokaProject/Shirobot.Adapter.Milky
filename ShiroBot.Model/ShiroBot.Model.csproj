<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ShiroBot.Adapter.Milky.Model</AssemblyName>
    <RootNamespace>ShiroBot.Adapter.Milky.Model</RootNamespace>
    <PackageId>ShiroBot.Adapter.Milky.Model</PackageId>
    <Version>1.3.0</Version>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>ShirokaProject</Authors>
    <Description>Shared Milky protocol models for ShiroBot plugins, adapters and the host.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageTags>ShiroBot;bot;model</PackageTags>
    <PackageProjectUrl>https://github.com/ShirokaProject/ShiroBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirokaProject/ShiroBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Milky 1.3.0 models generated from the official locked IR, with additive constructor and Deconstruct ABI preservation.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
